screen:
  name: "PiconDownloadProgress"
  position: "center,center"
  size: "900,330"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        font: "$FR_medium"
        halign: "left"
        name: "operation"
        position: "10,65"
        size: "e-20,40"
        transparent: "1"
        valign: "center"
    - widget:
        name: "slider1"
        position: "10,120"
        size: "e-20,20"
    - widget:
        font: "$FR_medium"
        halign: "left"
        name: "name"
        position: "10,155"
        size: "e-20,40"
        transparent: "1"
        valign: "center"
    - widget:
        font: "$FR_medium"
        halign: "left"
        name: "status"
        position: "10,210"
        size: "e-20,40"
        transparent: "1"
        valign: "center"
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
