screen:
  name: "PiconCockpit"
  position: "center,center"
  size: "1280,720"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        alphatest: "blend"
        name: "preview"
        position: "e-20-280,65"
        scale: "1"
        size: "280,168"
        zPosition: "2"
    - widget:
        font: "$FR_verysmall"
        itemHeight: "30"
        position: "20,65"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "e-340,570"
        source: "list"
        valign: "center"
        children:
          - convert:
              type: "StringList"
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
